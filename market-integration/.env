# Symbols the connector tracks, comma separated
MARKET_SYMBOLS=AAPL,MSFT,TSLA

# How often the mock connector emits an update, in seconds
MOCK_INTERVAL_SECONDS=0.5

# Bound on the connector->processor queue. 0 = unbounded.
# Set this before pointing at a real, high-throughput provider.
QUEUE_MAX_SIZE=0

# Filled in once a real provider is chosen — unused by the mock connector.
MARKET_PROVIDER_URL=
MARKET_PROVIDER_API_KEY=

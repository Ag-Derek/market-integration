# Symbols the connector tracks, comma separated (e.g. MTNGH,GCB,SCB).
# Leave empty to track every active equity in data/instruments.json.
MARKET_SYMBOLS=

# SQLite database for the instruments table and aggregated candles.
MARKET_DB_PATH=market_data.db

# How often the mock connector emits an update, in seconds
MOCK_INTERVAL_SECONDS=0.5

# mock (the GSE equities mock) or load (synthetic equities at a fixed
# rate, for load tests; see docs/benchmarks.md). Load mode only: the
# overall rate (empty = LOAD_TICKS_PER_INSTRUMENT x LOAD_INSTRUMENTS),
# and bursts of LOAD_BURST_MULTIPLIER x for LOAD_BURST_SECONDS, from
# LOAD_BURST_AFTER_SECONDS in, repeating every LOAD_BURST_EVERY_SECONDS
# (0 = once).
FEED_MODE=mock
LOAD_INSTRUMENTS=100
LOAD_TICKS_PER_SECOND=
LOAD_TICKS_PER_INSTRUMENT=1
LOAD_BURST_MULTIPLIER=10
LOAD_BURST_SECONDS=0
LOAD_BURST_AFTER_SECONDS=30
LOAD_BURST_EVERY_SECONDS=0

# Per-subscriber queue size on the connector->consumers buffer. When a
# subscriber falls behind, the oldest buffered tick for it is dropped.
QUEUE_MAX_SIZE=200

# Each WebSocket client gets one batched message of its symbols' latest
# ticks at most this often (ms); 0 = as soon as something changes.
WS_SEND_INTERVAL_MS=250

# Queue size for the branches that must not lose ticks (candles, alerts),
# and how long the feed may pause for one that's full before it drops.
LOSSLESS_QUEUE_MAX_SIZE=10000
LOSSLESS_BLOCK_SECONDS=0.5

# Trading calendar (session hours, trading days, Ghana public holidays).
MARKET_CALENDAR_PATH=data/market_calendar.json

# Force the session state to open, pre_open or closed, whatever the time.
# The mock only trades while the market is open, so set this to "open" to
# see prices move outside GSE hours. Leave empty in production.
MARKET_SESSION_OVERRIDE=

# Seconds without a feed heartbeat before the badge shows "Delayed", and
# how often WebSocket clients get a status message.
FEED_STALE_SECONDS=15
STATUS_INTERVAL_SECONDS=5

# Reconnecting a dropped feed: first retry after ~1s, doubling up to 30s,
# with up to half of each delay randomised.
RECONNECT_INITIAL_DELAY_SECONDS=1
RECONNECT_MAX_DELAY_SECONDS=30
RECONNECT_JITTER=0.5

# Bounds (% a year) outside which a bill or bond yield is rejected.
FI_YIELD_MIN=0
FI_YIELD_MAX=100

# Fixed-income mock (GFIM): stream wake-up interval (seconds); seconds
# between quotes per segment or symbol, e.g. treasury_bill=2,GHGGOG069931=0.5
# (0 = only on trades); burst rate (quotes per security per second, for
# load tests; 0 = off); and the GFIM session hours.
FI_MOCK_INTERVAL_SECONDS=0.5
FI_QUOTE_INTERVALS=
FI_BURST_RATE=0
FI_SESSION_OPEN=09:00
FI_SESSION_CLOSE=16:00

# Filled in once a real provider is chosen — unused by the mock connector.
MARKET_PROVIDER_URL=
MARKET_PROVIDER_API_KEY=
